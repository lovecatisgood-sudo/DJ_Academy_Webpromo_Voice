{
  "name": "djay-bot-saas-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "package:release": "pnpm run build && node scripts/package-release.mjs",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint && pnpm run lint:boundaries && pnpm run lint:browser-origins && pnpm run lint:auth-cookies && pnpm run lint:runtime-proxies && pnpm run lint:ui-recovery && pnpm run lint:widget-foundation && pnpm run lint:legal-registration && pnpm run lint:production-config && pnpm run lint:onboarding-readiness && pnpm run lint:platform-snapshot && pnpm run lint:verification-continuity && pnpm run lint:auth-continuations && pnpm run lint:password-journeys",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "lint:browser-origins": "node scripts/check-browser-mutation-origins.mjs",
    "lint:auth-cookies": "node scripts/check-auth-cookie-writes.mjs",
    "lint:runtime-proxies": "node scripts/check-runtime-api-proxies.mjs",
    "lint:ui-recovery": "node scripts/check-ui-recovery.mjs",
    "lint:widget-foundation": "node scripts/check-widget-foundation.mjs",
    "lint:legal-registration": "node scripts/check-legal-registration.mjs",
    "lint:production-config": "node scripts/check-production-configuration.mjs",
    "lint:onboarding-readiness": "node scripts/check-onboarding-readiness.mjs",
    "lint:platform-snapshot": "node scripts/check-platform-snapshot.mjs",
    "lint:verification-continuity": "node scripts/check-verification-continuity.mjs",
    "lint:auth-continuations": "node scripts/check-auth-continuations.mjs",
    "lint:password-journeys": "node scripts/check-password-journeys.mjs",
    "test:db": "scripts/test-db-integration.sh",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "qa:p3-ui": "node scripts/qa-p3-ui.mjs",
    "qa:ui-foundation": "node scripts/qa-ui-foundation.mjs",
    "qa:p4-flowbot": "node scripts/qa-p4-flowbot.mjs",
    "qa:p5-ai-chat": "node scripts/qa-p5-ai-chat.mjs",
    "qa:p6-line": "node scripts/qa-p6-line.mjs",
    "qa:p7-voice": "node scripts/qa-p7-voice-widget.mjs",
    "qa:p8-voice-eval": "pnpm --filter @djay/ai-evals voice:evaluate",
    "qa:p8-voice-load": "pnpm --filter @djay/voice-gateway exec vitest run src/load.test.ts --reporter=verbose",
    "qa:p9-usage": "node scripts/qa-p9-usage.mjs",
    "qa:p9-operations": "node scripts/qa-p9-operations.mjs",
    "qa:p9-status": "node scripts/qa-p9-status.mjs",
    "qa:p9-resilience": "P9_RESILIENCE_ONLY=true scripts/test-db-integration.sh",
    "qa:p9-recovery": "P9_RECOVERY_ONLY=true scripts/test-db-integration.sh",
    "qa:p9-dependency-outage": "pnpm --filter @djay/provider-gateway exec vitest run src/index.test.ts && pnpm --filter @djay/ai-chat-runtime exec vitest run src/index.test.ts && pnpm --filter @djay/voice-gateway exec vitest run src/media.test.ts && pnpm --filter @djay/notifications exec vitest run src/notifications.test.ts && pnpm --filter @djay/channel-adapters exec vitest run src/index.test.ts",
    "qa:p9-restore": "scripts/test-p9-backup-restore.sh",
    "qa:release-artifacts": "node scripts/qa-release-artifacts.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "playwright": "1.61.1",
    "turbo": "2.9.14",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}

# Meta / Facebook app-level integration.
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret-without-label-text
META_GRAPH_API_VERSION=v23.0
META_GRAPH_BASE_URL=https://graph.facebook.com/v23.0
META_OAUTH_REDIRECT_URI=https://djbot-api.djai.academy/integrations/meta/oauth/callback

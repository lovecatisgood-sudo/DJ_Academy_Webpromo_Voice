NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3100
TENANT_APP_URL=http://localhost:3101
PLATFORM_APP_URL=http://localhost:3102
API_APP_URL=http://localhost:3103
NEXT_PUBLIC_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_API_APP_URL=http://localhost:3103
NEXT_PUBLIC_WIDGET_CDN_URL=https://cdn.djaybot.com
AUTH_DATABASE_URL=postgresql://djay_auth_runtime:change-me@localhost:5432/djay_saas
TENANT_DATABASE_URL=postgresql://djay_runtime:change-me@localhost:5432/djay_saas
PLATFORM_DATABASE_URL=postgresql://djay_platform:change-me@localhost:5432/djay_saas
WORKER_DATABASE_URL=postgresql://djay_worker:change-me@localhost:5432/djay_saas
FLOWBOT_DATABASE_URL=postgresql://djay_flowbot_runtime:change-me@localhost:5432/djay_saas
AI_DATABASE_URL=postgresql://djay_ai_runtime:change-me@localhost:5432/djay_saas
VOICE_DATABASE_URL=postgresql://djay_voice_runtime:change-me@localhost:5432/djay_saas
VOICE_RUNTIME_ENABLED=false
BILLING_DATABASE_URL=postgresql://djay_worker:change-me@localhost:5432/djay_saas
DATABASE_MIGRATION_URL=postgresql://djay_migrator:change-me@localhost:5432/djay_saas
AUTH_REQUEST_HASH_KEY=base64-encoded-32-byte-secret
AUTH_EMAIL_ENVELOPE_KEY=base64-encoded-different-32-byte-secret
PRIVACY_EXPORT_KEY=base64-encoded-different-32-byte-secret
PRIVACY_WORKER_ENABLED=false
FLOWBOT_WORKER_ENABLED=false
AI_WORKER_ENABLED=false
AUTH_RATE_LIMIT_KEY=base64-encoded-third-32-byte-secret
AUTH_MFA_ENCRYPTION_KEY=base64-encoded-tenant-mfa-32-byte-secret
AUTH_MFA_RECOVERY_HASH_KEY=base64-encoded-tenant-recovery-32-byte-secret
PLATFORM_MFA_ENCRYPTION_KEY=base64-encoded-platform-mfa-32-byte-secret
PLATFORM_RECOVERY_HASH_KEY=base64-encoded-platform-recovery-32-byte-secret
BILLING_WEBHOOK_SECRET=base64-encoded-billing-signature-32-byte-secret
BILLING_WEBHOOK_ENVELOPE_KEY=base64-encoded-billing-envelope-32-byte-secret
FLOWBOT_INTEGRATION_ENVELOPE_KEY=base64-encoded-flowbot-integration-32-byte-secret
FLOWBOT_NOTIFICATION_ENVELOPE_KEY=base64-encoded-flowbot-notification-32-byte-secret
AI_NOTIFICATION_ENVELOPE_KEY=base64-encoded-ai-notification-32-byte-secret
AI_SOCIAL_CREDENTIAL_ENVELOPE_KEY=base64-encoded-ai-social-credential-32-byte-secret
AI_SOCIAL_SUBJECT_HASH_KEY=base64-encoded-ai-social-subject-hash-32-byte-secret
AI_SOCIAL_LINE_API_BASE_URL=https://api.line.me/
AI_SOCIAL_META_GRAPH_BASE_URL=https://graph.facebook.com/v23.0/
AI_SOCIAL_WORKER_ENABLED=false
AI_TEXT_GATEWAY_ENDPOINT=https://internal-ai-gateway.example.test/v1/generate
AI_TEXT_GATEWAY_SERVICE_TOKEN=replace-with-internal-ai-gateway-service-token
VOICE_GATEWAY_URL=wss://voice-gateway.example.test/v1/connect
VOICE_AUTHORIZATION_ENDPOINT=http://api:3103/internal/voice/sessions/authorize
VOICE_HEARTBEAT_ENDPOINT=http://api:3103/internal/voice/sessions/heartbeat
VOICE_DISCONNECT_ENDPOINT=http://api:3103/internal/voice/sessions/disconnect
VOICE_FINISH_ENDPOINT=http://api:3103/internal/voice/sessions/finish
VOICE_MEDIA_CONTEXT_ENDPOINT=http://api:3103/internal/voice/sessions/context
VOICE_TURN_ENDPOINT=http://api:3103/internal/voice/sessions/turn
VOICE_AUTHORIZATION_SERVICE_TOKEN=replace-with-independent-voice-service-token
VOICE_GEN1_API_KEY=replace-with-restricted-live-voice-api-key

VOICE_GEN2_REGION_KEY=replace-with-qualified-region-key
VOICE_GEN2_VOICE_NAME=replace-with-qualified-voice-name
VOICE_GATEWAY_MAX_SESSIONS=100
VOICE_SILENCE_WARNING_SECONDS=45
VOICE_IDLE_TIMEOUT_SECONDS=60
VOICE_SESSION_GRANT_TTL_SECONDS=60
VOICE_RECONNECT_MAX_ATTEMPTS=3
VOICE_RECONNECT_BACKOFF_MS=500
VOICE_REAPER_ENABLED=false
VOICE_REAPER_STALE_SECONDS=30

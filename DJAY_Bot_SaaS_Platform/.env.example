# LINE Login channel for merchant identity and setup wizard.
LINE_LOGIN_CHANNEL_ID=replace-with-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=replace-with-line-login-channel-secret
LINE_LOGIN_CALLBACK_URL=https://djbot-api.djai.academy/integrations/line/oauth/callback
LINE_LOGIN_SCOPES="profile openid email"
LINE_CONNECT_SUPPORT_EMAIL=support@example.com

# LINE Messaging API template for one test merchant only.
# Production merchant-specific credentials belong in encrypted per-tenant storage.
LINE_TEST_MERCHANT_LINE_CHANNEL_ID=replace-with-messaging-api-channel-id
LINE_TEST_MERCHANT_LINE_CHANNEL_SECRET=replace-with-messaging-api-channel-secret
LINE_TEST_MERCHANT_LINE_CHANNEL_ACCESS_TOKEN=replace-with-messaging-api-channel-access-token
LINE_TEST_MERCHANT_LINE_WEBHOOK_URL=https://djbot-api.djai.academy/api/public/ai-chat/social/line/{webhookKey}
# =============================================================================
# DATABASE CONNECTION STRINGS — WHICH STRING GOES WHERE
# =============================================================================
#
# This file needs only ONE database. Every variable below points at the SAME
# database; they differ only in which restricted PostgreSQL ROLE logs in, so that
# a compromised service cannot read another service's tables.
#
# You paste TWO different strings into THIS file:
#
#   STRING 1A — MIGRATION / OWNER.  ONE variable: DATABASE_MIGRATION_URL.
#               Use the DIRECT (non-pooled) Neon host and the OWNER role.
#               On Neon the direct host has NO "-pooler" in it.
#               Owns schema. Creates the runtime roles. Applies migrations.
#
#   STRING 1B — RUNTIME (POOLED).  EIGHT variables, listed below.
#               Use the POOLED Neon host — the one WITH "-pooler" in it.
#               Same host and database for all eight; change only the username
#               and password to the matching restricted role.
#
# Why the split: migrations need owner rights and a stable session, so they must
# NOT go through the pooler. Runtime services must NOT have owner rights.
#
# The other two databases in this repo live in OTHER files, not here:
#   STRING 2 — live single-tenant root app  ->  <repo root>/.env.local
#   STRING 3 — FlowBot V1 reference         ->  FlowBot_V1_App/.env.local
#                                               and FlowBot_V1_App/apps/dashboard/.env.local
# STRING 3 currently points at STRING 2's live database. Give it its own.
#
# Format for every string:
#   postgresql://<role>:<password>@<host>/<database>?sslmode=require
# =============================================================================

# --- STRING 1B (pooled runtime) — role: djay_auth_runtime -------------------
AUTH_DATABASE_URL=postgresql://djay_auth_runtime:change-me@localhost:5432/djay_saas
# --- STRING 1B (pooled runtime) — role: djay_runtime -----------------------
TENANT_DATABASE_URL=postgresql://djay_runtime:change-me@localhost:5432/djay_saas
# --- STRING 1B (pooled runtime) — role: djay_platform ----------------------
PLATFORM_DATABASE_URL=postgresql://djay_platform:change-me@localhost:5432/djay_saas
# --- STRING 1B (pooled runtime) — role: djay_worker ------------------------
WORKER_DATABASE_URL=postgresql://djay_worker:change-me@localhost:5432/djay_saas
SOCIAL_CHANNELS_RELEASE_ENABLED=false
ENTITLEMENT_CHANGE_WORKER_ENABLED=false
USAGE_ALERT_WORKER_ENABLED=false
USAGE_ALERT_NOTIFICATION_ENVELOPE_KEY=base64-encoded-different-32-byte-secret
USAGE_PERIOD_WORKER_ENABLED=false
USAGE_RECONCILIATION_WORKER_ENABLED=false
KNOWLEDGE_WORKER_ENABLED=false
KNOWLEDGE_OBJECT_BUCKET=replace-with-private-knowledge-object-bucket
MALWARE_SCANNER_ENDPOINT=https://malware-scanner.example.test/v1/scan
MALWARE_SCANNER_TOKEN=replace-with-malware-scanner-token
# --- STRING 1B (pooled runtime) — role: djay_flowbot_runtime ---------------
FLOWBOT_DATABASE_URL=postgresql://djay_flowbot_runtime:change-me@localhost:5432/djay_saas
# --- STRING 1B (pooled runtime) — role: djay_ai_runtime --------------------
AI_DATABASE_URL=postgresql://djay_ai_runtime:change-me@localhost:5432/djay_saas
# --- STRING 1B (pooled runtime) — role: djay_voice_runtime -----------------
VOICE_DATABASE_URL=postgresql://djay_voice_runtime:change-me@localhost:5432/djay_saas
VOICE_RUNTIME_ENABLED=false
# --- STRING 1B (pooled runtime) — role: djay_worker (SAME as WORKER_DATABASE_URL;
#     an alias, not another database) ----------------------------------------
BILLING_DATABASE_URL=postgresql://djay_worker:change-me@localhost:5432/djay_saas
# --- STRING 1A (DIRECT, NOT pooled) — role: owner --------------------------
#     The only variable that uses the direct host (no "-pooler") and the owner
#     role. Creates roles and applies schema migrations. Never used at runtime.
DATABASE_MIGRATION_URL=postgresql://database_owner:change-me@localhost:5432/djay_saas
DATABASE_CONFIGURE_RUNTIME_ROLES=true
AUTH_REQUEST_HASH_KEY=base64-encoded-32-byte-secret
AUTH_EMAIL_ENVELOPE_KEY=base64-encoded-different-32-byte-secret
PRIVACY_EXPORT_KEY=base64-encoded-different-32-byte-secret
PRIVACY_WORKER_ENABLED=false
FLOWBOT_WORKER_ENABLED=false
AI_WORKER_ENABLED=false
AUTH_RATE_LIMIT_KEY=base64-encoded-third-32-byte-secret
AUTH_MFA_ENCRYPTION_KEY=base64-encoded-tenant-mfa-32-byte-secret
AUTH_MFA_RECOVERY_HASH_KEY=base64-encoded-tenant-recovery-32-byte-secret
PLATFORM_MFA_ENCRYPTION_KEY=base64-encoded-platform-mfa-32-byte-secret
PLATFORM_RECOVERY_HASH_KEY=base64-encoded-platform-recovery-32-byte-secret
BILLING_WEBHOOK_SECRET=base64-encoded-billing-signature-32-byte-secret
BILLING_WEBHOOK_ENVELOPE_KEY=base64-encoded-billing-envelope-32-byte-secret
BILLING_CHECKOUT_ENVELOPE_KEY=base64-encoded-billing-checkout-32-byte-secret
BILLING_NOTIFICATION_ENVELOPE_KEY=base64-encoded-billing-notification-32-byte-secret
BILLING_FINANCIAL_ENVELOPE_KEY=base64-encoded-billing-financial-evidence-32-byte-secret
STRIPE_SECRET_KEY=replace-with-restricted-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
STRIPE_LIVE_MODE=false
